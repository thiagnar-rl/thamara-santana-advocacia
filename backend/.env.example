# Copie este arquivo para ".env" se quiser personalizar (opcional).
# Na Vercel, estas variáveis são cadastradas no painel do projeto
# (Settings → Environment Variables).

# Porta da API (só no computador)
PORT=3000

# Segredo usado para assinar o login (JWT).
# No computador pode ficar vazio (um segredo é gerado em data/.jwt-secret).
# Na Vercel é OBRIGATÓRIO: use um texto longo e aleatório.
JWT_SECRET=

# Banco na nuvem (Turso). Se ficar vazio, usa o arquivo local data/agenda.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Coloque "false" para impedir a criação de novas contas
# (recomendado depois de criar a conta da advogada no site publicado).
PERMITIR_CADASTRO=true

# [F3] "Esqueci minha senha" — envio do link por e-mail.
# Com Gmail: ative a verificação em duas etapas e crie uma "senha de app" em
# https://myaccount.google.com/apppasswords (16 letras). Use essa senha aqui, NUNCA a senha normal.
# No computador, se ficar vazio, o e-mail aparece no terminal da API (nada é enviado).
SMTP_USUARIO=
SMTP_SENHA=
# Opcionais:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=465
# EMAIL_REMETENTE="Thamara Santana Advocacia" <seuemail@gmail.com>
# APP_URL=https://thamara-santana-advocacia.vercel.app   (endereço usado no link do e-mail)
