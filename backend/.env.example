# Copie este arquivo para ".env" se quiser personalizar (opcional).
# Na Vercel, estas variáveis são cadastradas no painel do projeto
# (Settings → Environment Variables).

# Porta da API (só no computador)
PORT=3000

# Segredo usado para assinar o login (JWT).
# No computador pode ficar vazio (um segredo é gerado em data/.jwt-secret).
# Na Vercel é OBRIGATÓRIO: use um texto longo e aleatório.
JWT_SECRET=

# Banco na nuvem (Turso). Se ficar vazio, usa o arquivo local data/agenda.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Coloque "false" para impedir a criação de novas contas
# (recomendado depois de criar a conta da advogada no site publicado).
PERMITIR_CADASTRO=true
